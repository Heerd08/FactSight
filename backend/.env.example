# FactSight Backend Configuration

# Model path: either a HuggingFace model ID or local path to fine-tuned model
MODEL_PATH=microsoft/deberta-v3-base
MODEL_VERSION=deberta-v3-base-baseline-v1

# Database
DATABASE_URL=sqlite:///./factsight.db

# Server
HOST=0.0.0.0
PORT=8000

# Classification
CONFIDENCE_THRESHOLD=0.5
# Labels used by the model (comma-separated)
LABEL_MAP=Genuine,Misleading,Fake

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
